<Window x:Class="ArchaeologicalSiteManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Archaeological Site Management" Height="700" Width="1100">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Undo" Width="80" Margin="5,0" Click="Undo_Click"/>
            <Button Content="Redo" Width="80" Margin="5,0" Click="Redo_Click"/>
            <Button Content="Save" Width="80" Margin="5,0" Click="Save_Click"/>
            <Button Content="Load" Width="80" Margin="5,0" Click="Load_Click"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="0,10,0,0">

            <!-- Tab 1: Sites -->
            <TabItem Header="Archaeological Sites">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Text="{Binding SearchSite, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,10,5"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Sites}"
                                  SelectedItem="{Binding SelectedSite}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Margin="0,0,10,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                                <DataGridTextColumn Header="Civilization" Binding="{Binding Civilization}" Width="*"/>
                                <DataGridTextColumn Header="Discovery Year" Binding="{Binding DiscoveryYear}" Width="*"/>
                                <DataGridTextColumn Header="Site Type" Binding="{Binding SiteType}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Add" Width="80" Margin="5,0" Click="AddSite_Click"/>
                            <Button Content="Edit" Width="80" Margin="5,0" Click="EditSite_Click"/>
                            <Button Content="Delete" Width="80" Margin="5,0" Click="DeleteSite_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Form -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Name" Margin="0,5"/>
                        <TextBox Text="{Binding FormSite.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Location" Margin="0,5"/>
                        <TextBox Text="{Binding FormSite.Location, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Civilization" Margin="0,5"/>
                        <TextBox Text="{Binding FormSite.Civilization, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Discovery Year" Margin="0,5"/>
                        <TextBox Text="{Binding FormSite.DiscoveryYear, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Site Type" Margin="0,5"/>
                        <TextBox Text="{Binding FormSite.SiteType, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Excavations -->
            <TabItem Header="Excavation Records">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Margin="0,0,10,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding ExcavationDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                                <DataGridTextColumn Header="Area (m²)" Binding="{Binding AreaExcavatedM2}" Width="*"/>
                                <DataGridTextColumn Header="Artifacts" Binding="{Binding ArtifactsFound}" Width="*"/>
                                <DataGridTextColumn Header="Depth (cm)" Binding="{Binding DepthReachedCm}" Width="*"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Chart -->
                        <lvc:PieChart Grid.Row="1" Series="{Binding ChartVM.Series}" Margin="0,10,10,0"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Add" Width="80" Margin="5,0" Click="AddRecord_Click"/>
                            <Button Content="Edit" Width="80" Margin="5,0" Click="EditRecord_Click"/>
                            <Button Content="Delete" Width="80" Margin="5,0" Click="DeleteRecord_Click"/>
                            <Button Content="Simulate Next" Width="110" Margin="5,0" Click="SimulateNext_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Form -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Excavation Date" Margin="0,5"/>
                        <DatePicker SelectedDate="{Binding FormRecord.ExcavationDate}"/>
                        <TextBlock Text="Area (m²)" Margin="0,5"/>
                        <TextBox Text="{Binding FormRecord.AreaExcavatedM2, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Artifacts Found" Margin="0,5"/>
                        <TextBox Text="{Binding FormRecord.ArtifactsFound, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Depth (cm)" Margin="0,5"/>
                        <TextBox Text="{Binding FormRecord.DepthReachedCm, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="State" Margin="0,5"/>
                        <ComboBox ItemsSource="{Binding ExcavationStates}"
                                  SelectedItem="{Binding FormRecord.State}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>